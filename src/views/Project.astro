---
import { getEntry, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Cover from '../components/Cover.astro';
import { byRecent, categories, firstCommit, formatDay, formatSpan, lastCommit, totalCommits, type Project } from '../data/projects';
import { getLang, localizePath, useTranslations } from '../i18n/utils';
import { MAIN_SITE, SITE } from '../lib/seo';

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);

const entry = await getEntry('work', `${lang}/${p.slug}`);
if (!entry) throw new Error(`Missing case study src/content/work/${lang}/${p.slug}.md`);
const { Content } = await render(entry);

const category = categories.find((c) => c.id === p.category)!.label[lang];
const i = byRecent.findIndex((s) => s.slug === p.slug);
const prev = byRecent[(i - 1 + byRecent.length) % byRecent.length];
const next = byRecent[(i + 1) % byRecent.length];

const period = p.spans.length > 1
  ? p.spans.map((s) => `${s.label}: ${formatDay(s.start, lang)}${s.start === s.end ? '' : ` - ${formatDay(s.end, lang)}`}`)
  : [`${formatDay(firstCommit(p), lang)}${firstCommit(p) === lastCommit(p) ? '' : ` - ${formatDay(lastCommit(p), lang)}`}`];

const facts: [string, string | string[]][] = [
  [t('project.period'), period],
  [t('project.commits'), String(totalCommits(p))],
  [t('project.status'), p.status[lang]],
  [t('project.role'), p.role[lang]],
];

// share image: the cover cropped to 1200×630, or the site default
const og = p.cover ? await getImage({ src: p.cover.src, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' }) : undefined;
const pageUrl = `${SITE}${localizePath(`/work/${p.slug}/`, lang)}`;
const schema = [{
  '@type': 'CreativeWork',
  '@id': `${pageUrl}#work`,
  name: p.name,
  headline: `${p.name}: ${p.summary[lang]}`,
  description: p.summary[lang],
  url: pageUrl,
  ...(og ? { image: new URL(og.src, SITE).href } : {}),
  dateCreated: firstCommit(p),
  dateModified: lastCommit(p),
  genre: categories.find((c) => c.id === p.category)!.label.en,
  keywords: [...p.stack, ...p.ai].join(', '),
  inLanguage: lang,
  creator: { '@id': `${MAIN_SITE}/#person` },
  ...(p.links.find((l) => l.href.includes('github.com')) ? { codeRepository: p.links.find((l) => l.href.includes('github.com'))!.href } : {}),
}, {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('work.title'), item: `${SITE}${localizePath('/', lang)}#work` },
    { '@type': 'ListItem', position: 2, name: p.name, item: pageUrl },
  ],
}];
const hasRepo = p.links.some((l) => l.href.includes('github.com'));
---

<BaseLayout
  title={`${p.name} | Luiti Escobar`}
  description={`${p.summary[lang]} ${formatSpan(p, lang)}.`}
  current="work"
  image={og?.src}
  ogType="article"
  schema={schema}
>
  <article class="project">
    <header class="container p-head">
      <nav class="crumbs label" aria-label="Breadcrumb">
        <a href={`${localizePath('/', lang)}#work`}>{t('project.back')}</a>
        <span aria-hidden="true">/</span>
        <span>{category}</span>
      </nav>
      <h1>{p.name}</h1>
      <p class="lead">{p.summary[lang]}</p>
      <dl class="facts">
        {facts.map(([k, v]) => (
          <div>
            <dt class="label">{k}</dt>
            <dd>{Array.isArray(v) ? v.map((line) => <span>{line}</span>) : v}</dd>
          </div>
        ))}
      </dl>
    </header>

    {p.cover && <div class="container p-cover">
      <Cover project={p} size="big" sizes="(min-width: 1264px) 1200px, 100vw" eager />
    </div>}

    <div class="container p-body">
      <div class="prose">
        <Content />
      </div>
      <aside class="rail">
        <div>
          <h2 class="label">{t('project.stack')}</h2>
          <ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul>
        </div>
        {p.ai.length > 0 && <div>
          <h2 class="label">{t('project.ai')}</h2>
          <ul class="tags">{p.ai.map((s) => <li>{s}</li>)}</ul>
        </div>}
        <div>
          <h2 class="label">{t('project.links')}</h2>
          {p.links.length > 0 && <ul class="links">
            {p.links.map((l) => <li><a class="text-link" href={l.href} rel="noopener" target="_blank">{l.label[lang]} <span aria-hidden="true">↗</span></a></li>)}
          </ul>}
          {!hasRepo && <p class="rail__note">{t('project.repoPrivate')}</p>}
        </div>
      </aside>
    </div>

    <nav class="container nextprev" aria-label={`${t('project.prev')} / ${t('project.next')}`}>
      {[[prev, t('project.prev'), 'prev'], [next, t('project.next'), 'next']].map(([s, label, dir]) => {
        const item = s as Project;
        return (
          <a class:list={['np', `np--${dir}`]} href={localizePath(`/work/${item.slug}`, lang)} rel={dir as string}>
            <span class="label">{label}</span>
            <strong>{item.name}</strong>
            <span class="np__sum">{item.summary[lang]}</span>
          </a>
        );
      })}
    </nav>
  </article>
</BaseLayout>

<style>
  .p-head { padding-top: 32px; }
  .crumbs { display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 20px; }
  .crumbs a { transition: color .2s; }
  .crumbs a:hover { color: var(--ink); }
  h1 { font-size: clamp(44px, 7vw, 104px); font-weight: 200; line-height: .98; letter-spacing: -.035em; max-width: 960px; text-wrap: balance; }
  .lead { margin-top: 18px; max-width: 640px; font-size: 18px; line-height: 1.5; color: var(--ink-2); text-wrap: pretty; }
  .facts { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--line); }
  .facts dd { margin-top: 6px; font-size: 15px; font-weight: 400; display: grid; }

  .p-cover { margin-top: 36px; }

  .p-body { margin-top: 48px; display: grid; gap: 48px; }

  .prose { max-width: 680px; }
  .prose :global(h2) { font-size: clamp(24px, 2.4vw, 30px); font-weight: 300; letter-spacing: -.01em; line-height: 1.25; margin: 48px 0 14px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { color: var(--ink-2); margin-top: 16px; text-wrap: pretty; }
  .prose :global(h2 + p) { margin-top: 0; }
  .prose :global(strong) { color: var(--ink); font-weight: 400; }
  .prose :global(code) {
    font-family: var(--mono); font-size: .84em; padding: 2px 6px; border-radius: 6px;
    background: var(--raised); color: var(--ink); white-space: nowrap;
  }
  .prose :global(a) { color: var(--ink); border-bottom: 1px solid var(--line-2); }
  .prose :global(p:has(> img)) { margin-top: 32px; }
  .prose :global(img) { width: 100%; height: auto; border-radius: 14px; border: 1px solid var(--line); }
  /* an italic-only paragraph right after an image is its caption */
  .prose :global(p:has(> img) + p:has(> em:only-child)) { margin-top: 10px; font-size: 14px; color: var(--muted); }
  .prose :global(p:has(> img) + p > em:only-child) { font-style: normal; }
  .prose :global(p:has(> img) + p:has(> em:only-child) + p) { margin-top: 28px; }
  .prose :global(ul) { margin-top: 16px; padding-left: 1.1em; color: var(--ink-2); display: grid; gap: 6px; }

  .rail { display: grid; gap: 28px; align-content: start; }
  .rail h2 { margin-bottom: 10px; font-weight: 400; }
  .tags { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; }
  .tags li { padding: 4px 10px; border: 1px solid var(--line-2); border-radius: 99px; font-size: 13px; color: var(--ink-2); }
  .links { list-style: none; display: grid; gap: 10px; }
  .rail__note { margin-top: 10px; font-size: 14px; color: var(--muted); max-width: 22em; }

  .nextprev { display: grid; gap: 12px; margin-top: 88px; }
  .np {
    display: grid; gap: 6px; padding: 22px; border-radius: 18px; border: 1px solid var(--line);
    background: var(--surface); transition: border-color .25s;
  }
  .np:hover { border-color: var(--ink-2); }
  .np strong { font-size: 24px; font-weight: 300; }
  .np__sum { font-size: 15px; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .np--next { text-align: right; }

  @media (min-width: 768px) {
    .lead { margin-top: 24px; font-size: 21px; }
    .facts { grid-template-columns: repeat(4, 1fr); margin-top: 48px; padding-top: 24px; }
    .facts dd { font-size: 16px; }
    .p-cover { margin-top: 56px; }
    .nextprev { grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 120px; }
  }
  @media (min-width: 1024px) {
    .p-head { padding-top: 0; }
    .p-body { grid-template-columns: 1fr 300px; gap: 80px; margin-top: 88px; }
    .rail { position: sticky; top: 108px; }
  }
</style>

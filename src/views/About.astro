---
import { existsSync } from 'node:fs';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import EarlierWork from '../components/EarlierWork.astro';
import ContactStrip from '../components/ContactStrip.astro';
import profile from '../assets/images/profile.jpg';
import { byRecent, formatSpan } from '../data/projects';
import { languages, skills, training, workflow } from '../data/profile';
import { getLang, localizePath, useTranslations } from '../i18n/utils';
import { MAIN_SITE } from '../lib/seo';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const cv = lang === 'es' ? '/cv/luiti-escobar-cv-es.pdf' : '/cv/luiti-escobar-cv-en.pdf';
// the button only shows once the PDFs exist in public/cv (built by cv/build.mjs)
const cvReady = existsSync(`public${cv}`);
---

<BaseLayout title={t('about.meta')} current="about" schema={[{ '@type': 'ProfilePage', mainEntity: { '@id': `${MAIN_SITE}/#person` } }]}>
  <header class="container a-head">
    <div>
      <p class="label">{t('about.label')}</p>
      <h1>{t('about.title')}</h1>
      <p class="lead">{t('about.lead')}</p>
      {cvReady && <a class="cv" href={cv} download>{t('about.cv')} <span aria-hidden="true">(PDF)</span></a>}
    </div>
    <Image class="a-photo" src={profile} alt="Luiti Escobar" widths={[320, 480, 640]} sizes="(min-width: 1024px) 360px, 60vw" />
  </header>

  <section class="container block" aria-labelledby="workflow-title">
    <h2 class="section-title" id="workflow-title">{t('about.workflow')}</h2>
    <ul class="workflow">
      {workflow.map((w) => (
        <li>
          <h3>{w.title[lang]}</h3>
          <p>{w.text[lang]}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container block" aria-labelledby="projects-title">
    <h2 class="section-title" id="projects-title">{t('about.projects')}</h2>
    <ol class="xp">
      {byRecent.map((p) => (
        <li>
          <span class="label">{formatSpan(p, lang)}</span>
          <a href={localizePath(`/work/${p.slug}`, lang)}><strong>{p.name}</strong></a>
          <span class="xp__role">{p.role[lang]}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="container block">
    <EarlierWork level="h2" title={t('about.earlier')} intro="" />
  </section>

  <section class="container block design" aria-labelledby="design-title">
    <h2 class="section-title" id="design-title">{t('about.design')}</h2>
    <div>
      <p>{t('about.designText')}</p>
      <a class="text-link" href={lang === 'es' ? `${MAIN_SITE}/es/about` : `${MAIN_SITE}/about`}>{t('about.designLink')} <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <section class="container block facts" aria-label={`${t('about.skills')}, ${t('about.training')}, ${t('about.languages')}`}>
    <div>
      <h2 class="label">{t('about.skills')}</h2>
      <dl class="skills">
        {skills.map((s) => <div><dt>{s.group[lang]}</dt><dd>{s.items.join(', ')}</dd></div>)}
      </dl>
    </div>
    <div>
      <h2 class="label">{t('about.training')}</h2>
      <ul class="plain">
        {training.map((c) => <li><strong>{c.title}</strong>{c.issuer && <span>, {c.issuer}</span>}{c.detail && <small>{c.detail[lang]}</small>}</li>)}
      </ul>
      <h2 class="label lang-title">{t('about.languages')}</h2>
      <ul class="plain">
        {languages.map((l) => <li><strong>{l.name[lang]}</strong><small>{l.level[lang]}</small></li>)}
      </ul>
    </div>
  </section>

  <ContactStrip />
</BaseLayout>

<style>
  .a-head { display: grid; gap: 32px; padding-top: 32px; }
  .a-head .label { margin-bottom: 18px; }
  h1 { font-size: clamp(40px, 6vw, 84px); font-weight: 200; line-height: 1; letter-spacing: -.035em; max-width: 14em; text-wrap: balance; }
  .lead { margin-top: 22px; max-width: 34em; font-size: 19px; line-height: 1.5; color: var(--ink-2); }
  .cv {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 28px; min-height: 44px; padding: 0 20px;
    border-radius: 99px; background: var(--ink); color: var(--bg); font-weight: 400; font-size: 15px;
  }
  .cv span { opacity: .6; font-size: 13px; }
  .a-photo { width: min(60vw, 280px); height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: 0 10px 120px 0; filter: grayscale(1); }

  .block { margin-top: 96px; }
  .block > .section-title { margin-bottom: 28px; }

  .workflow { list-style: none; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .workflow li { display: grid; gap: 8px; padding: 24px 0; border-bottom: 1px solid var(--line); }
  .workflow h3 { font-size: 22px; font-weight: 300; }
  .workflow p { color: var(--ink-2); max-width: 40em; }

  .xp { list-style: none; border-top: 1px solid var(--line); }
  .xp li { display: grid; gap: 4px; padding: 16px 0; border-bottom: 1px solid var(--line); }
  .xp strong { font-weight: 300; font-size: 22px; transition: color .2s; }
  .xp a:hover strong { color: #fff; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .xp__role { color: var(--ink-2); font-size: 15px; }

  .design { display: grid; gap: 20px; }
  .design div { display: grid; gap: 18px; justify-items: start; max-width: 34em; color: var(--ink-2); }

  .facts { display: grid; gap: 48px; }
  .facts .label { margin-bottom: 14px; font-weight: 400; }
  .skills { display: grid; gap: 14px; }
  .skills dt { font-weight: 400; }
  .skills dd { color: var(--ink-2); }
  .plain { list-style: none; display: grid; gap: 14px; }
  .plain strong { font-weight: 400; }
  .plain span { color: var(--ink-2); }
  .plain small { display: block; font-size: 15px; color: var(--muted); }
  .lang-title { margin-top: 36px; }

  @media (min-width: 768px) {
    .workflow li { grid-template-columns: 280px 1fr; gap: 48px; padding: 28px 0; }
    .xp li { grid-template-columns: 180px 260px 1fr; gap: 32px; align-items: baseline; }
    .design { grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
    .facts { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 1024px) {
    .a-head { grid-template-columns: 1fr 360px; align-items: end; gap: 64px; padding-top: 0; }
    .a-photo { width: 100%; border-radius: 0 10px 180px 0; }
    .block { margin-top: 140px; }
    .block > .section-title { margin-bottom: 40px; }
  }
</style>

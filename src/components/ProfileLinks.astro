---
/** GitHub, LinkedIn and CV as pills: the three things a recruiter looks for first. */
import { existsSync } from 'node:fs';
import { socials } from '../data/profile';
import { getLang, useTranslations } from '../i18n/utils';

interface Props {
  class?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const cv = `/cv/luiti-escobar-cv-${lang}.pdf`;
// the CV pill only shows once cv/build.mjs has written the PDF to public/cv
const cvReady = existsSync(`public${cv}`);
const icons: Record<string, string> = {
  GitHub: 'M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z',
  LinkedIn: 'M13.63 13.63h-2.37V9.92c0-.89-.02-2.03-1.23-2.03-1.24 0-1.43.97-1.43 1.96v3.78H6.23V6h2.27v1.04h.03c.32-.6 1.09-1.23 2.25-1.23 2.4 0 2.85 1.58 2.85 3.64v4.18zM3.56 4.96a1.37 1.37 0 1 1 0-2.75 1.37 1.37 0 0 1 0 2.75zm1.19 8.67H2.37V6h2.38v7.63zM14.82 0H1.18C.53 0 0 .52 0 1.15v13.7C0 15.48.53 16 1.18 16h13.64c.65 0 1.18-.52 1.18-1.15V1.15C16 .52 15.47 0 14.82 0z',
};
---

<ul class:list={['links', Astro.props.class]}>
  {socials.map((s) => (
    <li>
      <a class="pill" href={s.href} rel="me noopener" target="_blank">
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path fill="currentColor" d={icons[s.label]} /></svg>
        {s.label}
      </a>
    </li>
  ))}
  {cvReady && (
    <li>
      <a class="pill pill--cv" href={cv} download>
        <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true"><path d="M8 2v8m0 0-3.2-3.2M8 10l3.2-3.2M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        {t('about.cv')}
      </a>
    </li>
  )}
</ul>

<style>
  .links { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 16px;
    border-radius: 99px; border: 1px solid var(--line-2); font-size: 14px; font-weight: 400; color: var(--ink);
    transition: border-color .2s, background .2s, color .2s;
  }
  .pill:hover { border-color: var(--ink); }
  .pill--cv { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .pill--cv:hover { background: var(--ink-2); border-color: var(--ink-2); }
</style>

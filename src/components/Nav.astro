---
import { languages, type Lang } from '../i18n/ui';
import { getLang, localizePath, switchLangPath, useTranslations } from '../i18n/utils';
import { MAIN_SITE } from '../lib/seo';

interface Props {
  /** key of the active link */
  current?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { current } = Astro.props;
const home = localizePath('/', lang);

const links = [
  { key: 'work', label: t('nav.work'), href: `${home}#work` },
  { key: 'timeline', label: t('nav.timeline'), href: `${home}#timeline` },
  { key: 'about', label: t('nav.about'), href: localizePath('/about', lang) },
  { key: 'contact', label: t('nav.contact'), href: `${home}#contact` },
];
const design = { label: t('nav.design'), href: lang === 'es' ? `${MAIN_SITE}/es/` : `${MAIN_SITE}/` };
const langs = Object.entries(languages) as [Lang, string][];
---

<header class="nav">
  <div class="container nav__bar">
    <a class="logo" href={home} aria-label="Luiti Escobar, AI developer, home">luiti<span>escobar</span><b aria-hidden="true">+</b></a>

    <nav class="nav__links" aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li class="nav__ext"><a href={design.href} rel="noopener">{design.label} <span aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>

    <div class="nav__actions">
      <div class="lang" role="group" aria-label={t('nav.language')}>
        {langs.map(([code, label]) => (
          <a href={switchLangPath(Astro.url.pathname, code)} hreflang={code} lang={code} aria-current={code === lang ? 'true' : undefined}>{label}</a>
        ))}
      </div>
      <button class="nav__toggle" aria-expanded="false" aria-controls="mobile-menu">
        <span class="visually-hidden">{t('nav.menu')}</span>
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><path d="M4 10h20M8 18h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" /></svg>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <ul class="container">
      {links.map((l) => (
        <li><a href={l.href} aria-current={current === l.key ? 'page' : undefined}>{l.label}</a></li>
      ))}
      <li class="mobile-menu__ext"><a href={design.href} rel="noopener">{design.label} ↗</a></li>
    </ul>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const menu = document.getElementById('mobile-menu');
  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    if (menu) menu.hidden = !open;
    document.documentElement.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  // in-page anchors close the menu
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });

  // compact header once the page scrolls
  const header = document.querySelector<HTMLElement>('.nav');
  const onScroll = () => header?.classList.toggle('is-scrolled', window.scrollY > 40);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .nav {
    /* fixed (not sticky) so compacting it on scroll doesn't shift the page; <main> reserves --header-h */
    position: fixed; inset: 0 0 auto; z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    transition: border-color .3s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled { border-bottom-color: var(--line); }
  .nav__bar {
    display: flex; align-items: center; justify-content: space-between;
    height: var(--header-h); transition: height .4s var(--ease);
  }

  .logo { display: inline-block; font-size: 22px; font-weight: 400; line-height: 1; transform-origin: left center; transition: transform .4s var(--ease); }
  .logo span { font-weight: 200; }
  .logo b { font-weight: 300; margin-left: .04em; }

  .nav__links { display: none; }
  .nav__links ul { display: flex; gap: 30px; list-style: none; font-size: 15px; align-items: center; }
  .nav__links a, .mobile-menu a { color: var(--ink-2); transition: color .2s; position: relative; }
  .nav__links a:hover, .nav__links a[aria-current] { color: var(--ink); }
  .nav__links a[aria-current] { font-weight: 400; }
  .nav__links a[aria-current]::after {
    content: ""; position: absolute; left: 50%; bottom: -9px;
    width: 5px; height: 5px; border-radius: 50%; background: var(--ink); transform: translateX(-50%);
  }
  .nav__ext { padding-left: 30px; border-left: 1px solid var(--line-2); }
  .nav__ext a { color: var(--muted); }

  .nav__actions { display: flex; align-items: center; gap: 14px; }
  .lang { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--line-2); border-radius: 99px; font-family: var(--mono); font-size: 11px; }
  .lang a { padding: 4px 9px; border-radius: 99px; color: var(--muted); transition: color .2s; }
  .lang a:hover { color: var(--ink); }
  .lang a[aria-current] { background: var(--ink); color: var(--bg); }

  .nav__toggle { display: grid; place-items: center; width: 44px; height: 44px; margin-right: -8px; }

  .mobile-menu { border-top: 1px solid var(--line); padding: 24px 0 40px; background: var(--bg); }
  .mobile-menu ul { list-style: none; display: grid; gap: 6px; }
  .mobile-menu a { font-size: 32px; font-weight: 200; letter-spacing: -.02em; }
  .mobile-menu a[aria-current] { color: var(--ink); font-weight: 400; }
  .mobile-menu__ext { margin-top: 18px; }
  .mobile-menu__ext a { font-size: 18px; font-weight: 300; color: var(--muted); }

  @media (min-width: 1024px) {
    .logo { font-size: clamp(36px, 3.34vw, 48px); }
    .nav.is-scrolled .nav__bar { height: 76px; }
    .nav.is-scrolled .logo { transform: scale(.625); }
    .nav__links { display: block; }
    .nav__toggle, .mobile-menu { display: none; }
    .lang { font-size: 12px; }
    .lang a { padding: 5px 10px; }
  }
  @media (min-width: 1024px) and (max-width: 1180px) {
    .nav__links ul { gap: 22px; font-size: 14px; }
    .nav__ext { padding-left: 22px; }
  }
</style>

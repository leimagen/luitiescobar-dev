{
  // dev.luitiescobar.com: static Astro build served as Workers static assets.
  // The Worker script only runs first for /cv/* (CV download counter + Telegram notice); everything else
  // is served straight from the assets.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luitiescobar-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/cv/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "luitiescobar-dev-events",
      "database_id": "2ea39142-f78b-430c-8e15-8ca06fd515c5",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "dev.luitiescobar.com", "custom_domain": true }
  ]
}

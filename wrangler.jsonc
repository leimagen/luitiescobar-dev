{
  // dev.luitiescobar.com: static Astro build served as Workers static assets (no Worker script).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "luitiescobar-dev",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true },
  "workers_dev": true,
  "routes": [
    { "pattern": "dev.luitiescobar.com", "custom_domain": true }
  ]
}
